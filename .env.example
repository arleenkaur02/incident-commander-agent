# Anthropic API key — used by the Root Cause Reasoning Agent
ANTHROPIC_API_KEY=your_key_here

# GitHub — used to pull recent deploys/commits for correlation
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# Slack — used to notify the correct on-call engineer
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Server
PORT=4000
